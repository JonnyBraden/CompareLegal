# Secrets for the Edge Functions. Copy to supabase/functions/.env (git-ignored), fill in, then:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.

# Stripe: use test-mode values first. The secret key must NEVER go in the site's (Render) variables.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Where Stripe and Supabase send people back to
SITE_URL=https://comparelegal.com

# Enquiry emails (Resend). The sender must be on a domain you have verified in Resend.
RESEND_API_KEY=re_xxx
MAIL_FROM=Compare Legal <enquiries@comparelegal.com>
